# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_MODEL=gemini-2.5-flash

# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/dbname
# For MySQL: mysql+aiomysql://user:password@localhost:3306/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatbot_db

# API Security
API_KEY=your_api_key_here
